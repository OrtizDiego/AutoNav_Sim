<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>person_actor_plugin</name>
  <version>0.1.0</version>
  <description>
    Gazebo Classic model plugin that drives an animated actor (walking/running
    pedestrian) from a geometry_msgs/Twist command, keeping the gait animation
    in sync with the distance actually travelled.
  </description>
  <maintainer email="autonav@example.com">AutoNav Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>gazebo_dev</depend>
  <depend>gazebo_ros</depend>
  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
    <!-- ${prefix} is share/person_actor_plugin; the .so lives in lib/ -->
    <gazebo_ros plugin_path="${prefix}/../../lib"/>
  </export>
</package>
