    <!--
    Visual meshes and dimensions follow the ROBOTIS TurtleBot3 Waffle Pi
    (https://github.com/ROBOTIS-GIT/turtlebot3, Apache-2.0). Link and joint
    names are kept from the original model so the rest of the stack
    (diff drive, SLAM, Nav2, behavior nodes) is unaffected.
    -->

    <material name="dark_grey">
        <color rgba="0.25 0.25 0.25 1"/>
    </material>

    <material name="black">
        <color rgba="0.1 0.1 0.1 1"/>
    </material>

    <!-- base_link sits between the drive wheels, 10 mm above the ground -->
    <link name="base_link">
    </link>

    <!-- chassis origin is the geometric centre of the Waffle Pi body -->
    <joint name="chassis_joint" type="fixed">
        <parent link="base_link"/>
        <child link="chassis"/>
        <origin xyz="-0.064 0 0"/>
    </joint>

    <link name="chassis">
        <visual>
            <geometry>
                <mesh filename="package://my_bot/meshes/waffle_pi_base.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="dark_grey"/>
        </visual>
        <!-- A cylinder, not the 0.266 m box of the real base: Gazebo's ODE
             ray-box test returns ghost hits on a box just below the scan
             plane whenever the robot is tilted even slightly (it rests at
             ~0.3 deg on its casters), so the lidar "saw" the box outline at
             0.12-0.2 m. Ray-cylinder has no such problem. -->
        <collision>
            <origin xyz="0 0 0.047"/>
            <geometry>
                <cylinder radius="0.133" length="0.094"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0.064 0 0" rpy="0 0 0"/>
            <mass value="1.3729096"/>
            <inertia ixx="8.7002718e-03" ixy="-4.7576583e-05" ixz="1.1160499e-04"
                     iyy="8.6195418e-03" iyz="-3.5422299e-06" izz="1.4612727e-02"/>
        </inertial>
    </link>

    <joint name="left_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="left_wheel"/>
        <origin xyz="0 0.144 0.023" rpy="-${pi/2} 0 0" />
        <axis xyz="0 0 1"/>
    </joint>

    <link name="left_wheel">
        <visual>
            <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
            <geometry>
                <mesh filename="package://my_bot/meshes/left_tire.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.033" length="0.018"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.028498940"/>
            <inertia ixx="1.1175580e-05" ixy="0" ixz="0" iyy="1.1192413e-05" iyz="0" izz="2.0712558e-05"/>
        </inertial>
    </link>

    <joint name="right_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="right_wheel"/>
        <origin xyz="0 -0.144 0.023" rpy="-${pi/2} 0 0" />
        <axis xyz="0 0 1"/>
    </joint>

    <link name="right_wheel">
        <visual>
            <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
            <geometry>
                <mesh filename="package://my_bot/meshes/right_tire.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.033" length="0.018"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.028498940"/>
            <inertia ixx="1.1175580e-05" ixy="0" ixz="0" iyy="1.1192413e-05" iyz="0" izz="2.0712558e-05"/>
        </inertial>
    </link>

    <!-- Two rear ball casters (their shells are part of the base mesh) -->
    <xacro:macro name="caster" params="side y">
        <joint name="caster_${side}_joint" type="fixed">
            <parent link="chassis"/>
            <child link="caster_${side}"/>
            <origin xyz="-0.113 ${y} -0.005"/>
        </joint>

        <link name="caster_${side}">
            <collision>
                <geometry>
                    <sphere radius="0.005"/>
                </geometry>
            </collision>
            <inertial>
                <mass value="0.005"/>
                <inertia ixx="1e-06" ixy="0" ixz="0" iyy="1e-06" iyz="0" izz="1e-06"/>
            </inertial>
        </link>

        <gazebo reference="caster_${side}">
            <mu1 value="0.001"/>
            <mu2 value="0.001"/>
        </gazebo>
    </xacro:macro>

    <xacro:caster side="back_left" y="0.064"/>
    <xacro:caster side="back_right" y="-0.064"/>

</robot>
