<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="default">
    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- 20 m x 20 m walled yard. person_controller keeps the pedestrian
         inside +/-8 m, so the walls only bound the scene for the lidar. -->
    <model name="yard_walls">
      <static>true</static>
      <link name="north">
        <pose>0 10 0.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>20.2 0.2 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>20.2 0.2 1.0</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
      </link>
      <link name="south">
        <pose>0 -10 0.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>20.2 0.2 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>20.2 0.2 1.0</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
      </link>
      <link name="east">
        <pose>10 0 0.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.2 20.2 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 20.2 1.0</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
      </link>
      <link name="west">
        <pose>-10 0 0.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.2 20.2 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 20.2 1.0</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
      </link>
    </model>

    <!--
      Pedestrian intruder.

      Skin and both clips come from Gazebo's bundled media (walk.dae and
      run.dae share the same CMU skeleton). There is deliberately no
      <script>: a scripted trajectory would overwrite the pose every frame.
      Motion comes from PersonActorPlugin, which reads /person/cmd_vel
      (published by person_controller) and plays the run clip above
      run_threshold. Gazebo gives each actor bone a collision box, so the
      robot's lidar sees the legs.

      <pose> yaw is the initial walking heading (here: facing the robot).
    -->
    <actor name="person_intruder">
      <pose>4.0 1.0 0 0 0 3.14159</pose>
      <skin>
        <filename>walk.dae</filename>
        <scale>1.0</scale>
      </skin>
      <animation name="walking">
        <filename>walk.dae</filename>
        <scale>1.0</scale>
        <interpolate_x>false</interpolate_x>
      </animation>
      <animation name="running">
        <filename>run.dae</filename>
        <scale>1.0</scale>
        <interpolate_x>false</interpolate_x>
      </animation>
      <plugin name="person_actor" filename="libperson_actor_plugin.so">
        <ros>
          <namespace>/person</namespace>
        </ros>
        <walking_animation>walking</walking_animation>
        <running_animation>running</running_animation>
        <run_threshold>1.6</run_threshold>
        <walk_animation_factor>4.15</walk_animation_factor>
        <run_animation_factor>1.71</run_animation_factor>
        <height>1.2138</height>
        <cmd_timeout>0.5</cmd_timeout>
      </plugin>
    </actor>
  </world>
</sdf>
